# --- LLM (pick one provider; never hard-code a model name in code) ---
LLM_PROVIDER=gemini            # gemini | anthropic | openai
LLM_MODEL=gemini-2.5-flash     # set to a currently available model for the provider
LLM_API_KEY=

# --- Discovery (Exa is primary, Yutori optional, Seed CSV last fallback) ---
SEARCH_PROVIDER=exa            # exa | yutori | seed
EXA_API_KEY=
YUTORI_API_KEY=
YUTORI_MAX_TASKS_PER_RUN=2     # hard cap, each task ~ $0.35
YUTORI_USER_LOCATION=Austin, TX, US

# --- Contact ---
HUNTER_API_KEY=
HUNTER_MAX_CREDITS_PER_RUN=6

# --- Email ---
MAIL_PROVIDER=dryrun           # gmail | resend | dryrun
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=             # Google App Password (2-Step Verification required)
RESEND_API_KEY=
SAFE_MODE=true                 # true = send to TEST_RECIPIENT only
TEST_RECIPIENT=you@gmail.com
LIVE_SEND_CONFIRM=             # must equal I_UNDERSTAND to allow --live
MAX_SENDS_PER_RUN=1

# --- Logging ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json   # sheet must be shared with its email
